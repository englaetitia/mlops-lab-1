# Files and folders NOT sent to the Docker daemon when building.

# Virtual environment: built on Windows, useless (and big) in a Linux image
.venv/

# Python cache
__pycache__/
*.py[cod]

# Data: versioned by dvc, not needed to serve the model
data/
data_local/

# Local MLflow files: the container talks to the tracking server over HTTP
mlruns/
mlartifacts/
mlflow.db

# git and dvc metadata (.dvc/cache is a second copy of all the data)
.git/
.dvc/
.dvcignore

# Editor / OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Reports and build files, not needed inside the image
lab/
WALKTHROUGH.md
Dockerfile
Dockerfile.naive
.dockerignore
